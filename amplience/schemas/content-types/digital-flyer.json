{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scheels.com/contentTypes/digital-flyer",

  "title": "Digital Flyer",
  "description": "Shoppable sale flyer: the PDF's pages as images with clickable product hotspots. Pages and hotspots come from Flyer Studio.",

  "allOf": [{ "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content" }],

  "type": "object",
  "properties": {
    "title": {
      "title": "Title",
      "type": "string",
      "maxLength": 80
    },
    "campaign": {
      "title": "Campaign code",
      "description": "Lowercase UTM campaign, e.g. biggame26.",
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "startDate": {
      "title": "Sale starts",
      "type": "string",
      "format": "date-time"
    },
    "endDate": {
      "title": "Sale ends",
      "type": "string",
      "format": "date-time"
    },
    "disclaimer": {
      "title": "Disclaimer",
      "type": "string",
      "format": "markdown"
    },
    "pdfUrl": {
      "title": "Flyer PDF",
      "description": "Optional. Static URL of the source PDF in ECOM Creative > Content Pages > Digital Flyers, for reference.",
      "type": "string",
      "format": "uri"
    },
    "pages": {
      "title": "Pages",
      "description": "Imported from Flyer Studio.",
      "type": "array",
      "ui:extension": { "name": "flyer-import" },
      "items": {
        "type": "object",
        "properties": {
          "image": {
            "title": "Page image",
            "allOf": [{ "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/image-link" }]
          },
          "hotspots": {
            "title": "Hotspots",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "box"],
              "properties": {
                "label": { "title": "Product", "type": "string" },
                "priceText": { "title": "Price as printed", "type": "string" },
                "box": {
                  "title": "Box (% of page)",
                  "type": "object",
                  "required": ["x", "y", "w", "h"],
                  "properties": {
                    "x": { "type": "number", "minimum": 0, "maximum": 100 },
                    "y": { "type": "number", "minimum": 0, "maximum": 100 },
                    "w": { "type": "number", "minimum": 0, "maximum": 100 },
                    "h": { "type": "number", "minimum": 0, "maximum": 100 }
                  }
                },
                "skus": {
                  "title": "SKUs",
                  "type": "array",
                  "items": { "type": "string" }
                },
                "objectIds": {
                  "title": "Scheels Search product ids",
                  "description": "objectID of each matched product, used by the product drawer.",
                  "type": "array",
                  "items": { "type": "string" }
                },
                "fallback": {
                  "title": "Link when no product",
                  "description": "The fields of https://scheels.com/partial/link, copied rather than referenced: resolving the partial for every hotspot slowed Amplience's editor. Keep the two in step.",
                  "type": "object",
                  "properties": {
                    "category": { "title": "Category", "description": "The category key of the category to be linked", "type": "string" },
                    "attributes": {
                      "title": "Attribute Refinements",
                      "type": "array",
                      "items": {
                        "title": "Attributes",
                        "type": "object",
                        "properties": {
                          "attributeName": { "title": "Attribute Name", "type": "string" },
                          "attributeValue": { "title": "Attribute Value", "type": "string" }
                        }
                      }
                    },
                    "onSale": { "title": "On Sale", "type": "boolean" },
                    "urlSlug": { "title": "URL Slug", "description": "A path on scheels.com, or a full URL to another site", "type": "string" },
                    "pageID": { "title": "Page ID", "description": "The page ID of the content page to be linked", "type": "string" },
                    "productID": { "title": "Product ID", "description": "If linking to a PDP, enter a product ID here", "type": "string" },
                    "anchor": { "title": "Anchor", "type": "string" },
                    "useStoreAvailability": { "title": "Use Store Availability", "type": "boolean" },
                    "newPage": { "title": "Open in New Page", "type": "boolean" },
                    "clickID": { "title": "Click ID", "description": "Click ID for analytics tracking", "type": "string" },
                    "searchTerm": {
                      "title": "Search term",
                      "description": "Used only when no category or attribute is set: links to search results for this term.",
                      "type": "string"
                    }
                  }
                },
                "description": {
                  "title": "Description",
                  "description": "Shown under the price in the product panel, e.g. the terms of an offer.",
                  "type": "string",
                  "maxLength": 300
                },
                "buttonText": {
                  "title": "Button text",
                  "description": "Replaces the panel button's text, which otherwise describes the link.",
                  "type": "string",
                  "maxLength": 60
                },
                "inStoreOnly": {
                  "title": "In store only",
                  "description": "Shown without an online link.",
                  "type": "boolean"
                },
                "locked": { "title": "Edited by hand", "type": "boolean" },
                "confidence": { "type": "string", "enum": ["high", "low"] }
              }
            }
          }
        }
      }
    }
  },
  "required": ["pages"],
  "propertyOrder": ["title", "campaign", "startDate", "endDate", "disclaimer", "pdfUrl", "pages"]
}
