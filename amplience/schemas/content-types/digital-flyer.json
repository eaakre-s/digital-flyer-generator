{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scheels.com/contentTypes/digital-flyer",

  "title": "Digital Flyer",
  "description": "Shoppable sale flyer: the PDF's pages as images with clickable product hotspots. Generate and edit the pages with the Flyer editor.",

  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],

  "type": "object",
  "properties": {
    "title": {
      "title": "Title",
      "type": "string",
      "maxLength": 80
    },
    "campaign": {
      "title": "Campaign code",
      "description": "Lowercase UTM campaign, e.g. biggame26.",
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "startDate": {
      "title": "Sale starts",
      "type": "string",
      "format": "date-time"
    },
    "endDate": {
      "title": "Sale ends",
      "type": "string",
      "format": "date-time"
    },
    "disclaimer": {
      "title": "Disclaimer",
      "type": "string",
      "format": "markdown"
    },
    "showWishlist": {
      "title": "Show Wishlist",
      "description": "Show wishlist button on inital product slideout",
      "type": "boolean"
    },
    "pages": {
      "title": "Pages",
      "description": "Generated from the PDF by the Flyer editor.",
      "type": "array",
      "ui:extension": {
        "name": "flyer-import"
      },
      "items": {
        "type": "object",
        "properties": {
          "image": {
            "title": "Page image",
            "allOf": [
              {
                "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/image-link"
              }
            ]
          },
          "hotspots": {
            "title": "Hotspots",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "box", "fallback"],
              "properties": {
                "label": {
                  "title": "Product",
                  "type": "string"
                },
                "priceText": {
                  "title": "Price as printed",
                  "type": "string"
                },
                "description": {
                  "title": "Description",
                  "description": "Shown under the price in the product panel, e.g. the terms of an offer.",
                  "type": "string",
                  "maxLength": 300
                },
                "box": {
                  "title": "Box (% of page)",
                  "type": "object",
                  "required": ["x", "y", "w", "h"],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "w": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "h": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  }
                },
                "skus": {
                  "title": "SKUs",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "objectIds": {
                  "title": "Scheels Search product ids",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "inStoreOnly": {
                  "title": "In Store Only",
                  "type": "boolean"
                },
                "fallback": {
                  "title": "Link when no product",
                  "type": "object",
                  "properties": {
                    "category": {
                      "title": "Category",
                      "type": "string"
                    },
                    "attributes": {
                      "title": "Attribute Refinements",
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "attributeName": {
                            "title": "Attribute Name",
                            "type": "string"
                          },
                          "attributeValue": {
                            "title": "Attribute Value",
                            "type": "string"
                          }
                        }
                      }
                    },
                    "onSale": {
                      "title": "On Sale",
                      "type": "boolean"
                    },
                    "urlSlug": {
                      "title": "URL Slug",
                      "type": "string"
                    },
                    "pageID": {
                      "title": "Page ID",
                      "type": "string"
                    },
                    "productID": {
                      "title": "Product ID",
                      "type": "string"
                    },
                    "anchor": {
                      "title": "Anchor",
                      "type": "string"
                    },
                    "newPage": {
                      "title": "Open in New Page",
                      "type": "boolean"
                    },
                    "clickID": {
                      "title": "Click ID",
                      "type": "string"
                    },
                    "searchTerm": {
                      "title": "Search term",
                      "type": "string"
                    }
                  }
                },
                "buttonText": {
                  "title": "Button text",
                  "description": "Replaces the panel button's text, which otherwise describes the link.",
                  "type": "string",
                  "maxLength": 60
                },
                "linksTitle": {
                  "title": "Links title",
                  "description": "Optional heading above the links at the bottom of the product panel.",
                  "type": "string",
                  "maxLength": 50
                },
                "links": {
                  "title": "Links",
                  "description": "Extra links at the bottom of the product panel, as on a shoppable image.",
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "required": ["label", "link"],
                    "properties": {
                      "label": {
                        "title": "Label",
                        "description": "Text of the link",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "ariaLabel": {
                        "title": "Aria label",
                        "description": "Optional. Read by screen readers after the label.",
                        "type": "string",
                        "maxLength": 255
                      },
                      "clickId": {
                        "title": "Click ID",
                        "description": "Optional. Id for Google Analytics; digital-flyer-link when empty.",
                        "type": "string"
                      },
                      "link": {
                        "title": "Link",
                        "description": "Same fields as Link when no product. Keep the two in step.",
                        "type": "object",
                        "properties": {
                          "category": {
                            "title": "Category",
                            "type": "string"
                          },
                          "attributes": {
                            "title": "Attribute Refinements",
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "attributeName": {
                                  "title": "Attribute Name",
                                  "type": "string"
                                },
                                "attributeValue": {
                                  "title": "Attribute Value",
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "onSale": {
                            "title": "On Sale",
                            "type": "boolean"
                          },
                          "urlSlug": {
                            "title": "URL Slug",
                            "type": "string"
                          },
                          "pageID": {
                            "title": "Page ID",
                            "type": "string"
                          },
                          "productID": {
                            "title": "Product ID",
                            "type": "string"
                          },
                          "anchor": {
                            "title": "Anchor",
                            "type": "string"
                          },
                          "newPage": {
                            "title": "Open in New Page",
                            "type": "boolean"
                          },
                          "clickID": {
                            "title": "Click ID",
                            "type": "string"
                          },
                          "searchTerm": {
                            "title": "Search term",
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                },
                "locked": {
                  "title": "Edited by hand",
                  "type": "boolean"
                },
                "confidence": {
                  "type": "string",
                  "enum": ["high", "low"]
                }
              }
            }
          }
        }
      }
    }
  },
  "required": ["pages"],
  "propertyOrder": ["title", "campaign", "startDate", "endDate", "showWishlist", "disclaimer", "pages"]
}
