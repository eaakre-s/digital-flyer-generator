{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scheels.com/contentTypes/digital-flyer",

  "title": "Digital Flyer",
  "description": "Shoppable sale flyer: the PDF's pages as images with clickable product hotspots. Generate and edit the pages with the Flyer editor.",

  "allOf": [
    {
      "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
    }
  ],
  "ui:component": {
    "name": "tabs",
    "params": {
      "tabs": {
        "defaultTab": "Flyer",
        "items": [
          { "label": "Settings", "pointers": ["/title", "/campaign", "/startDate", "/endDate", "/disclaimer", "/showWishlist"] },
          { "label": "Flyer", "pointers": ["/pages", "/parts"] },
          { "label": "Early Access", "pointers": ["/lock"] }
        ]
      }
    }
  },

  "type": "object",
  "properties": {
    "title": {
      "title": "Title",
      "type": "string",
      "maxLength": 80
    },
    "campaign": {
      "title": "Campaign code",
      "description": "Lowercase UTM campaign, e.g. biggame26.",
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "startDate": {
      "title": "Sale starts",
      "type": "string",
      "format": "date-time"
    },
    "endDate": {
      "title": "Sale ends",
      "type": "string",
      "format": "date-time"
    },
    "disclaimer": {
      "title": "Disclaimer",
      "type": "string",
      "format": "markdown"
    },
    "showWishlist": {
      "title": "Show Wishlist",
      "description": "Show wishlist button on inital product slideout",
      "type": "boolean"
    },
    "lock": {
      "title": "Early access lock",
      "description": "Like a product drop: until Lock End Time only the early access group sees the pages; everyone else sees the gate.",
      "type": "object",
      "properties": {
        "enabled": {
          "title": "Lock until Lock End Time",
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "enabled": { "const": false }
        }
      },
      "then": {},
      "else": {
        "required": ["lockEndTime", "earlyAccessCustomerGroup"],
        "properties": {
          "lockEndTime": {
            "title": "Lock End Time",
            "description": "When the flyer opens to everyone. Drives the countdown and every {date} token.",
            "type": "string",
            "format": "date-time"
          },
          "earlyAccessCustomerGroup": {
            "title": "Early Access Customer Group",
            "description": "MySCHEELS = every signed-in shopper. visaCardholder = signed-in SCHEELS Visa cardholders.",
            "type": "string",
            "enum": ["MySCHEELS", "visaCardholder"],
            "default": "MySCHEELS"
          },
          "eyebrowText": {
            "title": "Label",
            "description": "Small line above the title on the gate and the early access banner, e.g. 'MySCHEELS preview'. Leave empty for no label.",
            "type": "string",
            "maxLength": 40,
            "default": "MySCHEELS early access"
          },
          "showCountdown": {
            "title": "Show countdown",
            "description": "Days, hours and minutes to Lock End Time, in the early access banner and on the gate.",
            "type": "boolean",
            "default": true
          },
          "earlyAccessTitle": {
            "title": "Early access heading",
            "description": "Banner above the flyer for the early access group, e.g. 'Thank you for being a MySCHEELS customer!'",
            "type": "string",
            "maxLength": 120
          },
          "earlyAccessText": {
            "title": "Early access text",
            "description": "Under the heading, e.g. 'Everyone else sees it on {date}.' {date} becomes Lock End Time, e.g. Fri, Nov 20 at 8:00 AM CT.",
            "type": "string",
            "maxLength": 255
          },
          "gateImage": {
            "title": "Gate image",
            "description": "Shown in place of the flyer to everyone else. Bake any blur into the file; never use a readable flyer page.",
            "allOf": [{ "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/image-link" }]
          },
          "gateImageAlt": {
            "title": "Gate image alt text",
            "description": "Describe the image, including any words in it.",
            "type": "string",
            "maxLength": 255
          },
          "gateText": {
            "title": "Gate text",
            "description": "Under the gate image, e.g. 'Opens to everyone {date}.'",
            "type": "string",
            "maxLength": 255
          },
          "applyLinkLabel": {
            "title": "Apply link label",
            "description": "visaCardholder only: a link on the gate for signed-in shoppers who aren't cardholders. Leave empty for no link.",
            "type": "string",
            "maxLength": 50
          },
          "applyLink": {
            "title": "Apply link",
            "description": "Check Use Visa Apply Now Action for the SCHEELS Visa application, or set a page to link somewhere else. Empty = Apply Now action.",
            "allOf": [{ "$ref": "https://scheels.com/partial/visa-apply-now-link#/definitions/link" }]
          }
        }
      }
    },
    "pages": {
      "title": "Pages",
      "description": "Generated from the PDF by the Flyer editor.",
      "type": "array",
      "ui:extension": {
        "name": "flyer-import"
      },
      "items": {
        "type": "object",
        "properties": {
          "image": {
            "title": "Page image",
            "allOf": [
              {
                "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/image-link"
              }
            ]
          },
          "hotspots": {
            "title": "Hotspots",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "box", "fallback"],
              "properties": {
                "label": {
                  "title": "Product",
                  "type": "string"
                },
                "priceText": {
                  "title": "Price as printed",
                  "type": "string"
                },
                "description": {
                  "title": "Description",
                  "description": "Shown under the price in the product panel, e.g. the terms of an offer.",
                  "type": "string",
                  "maxLength": 300
                },
                "box": {
                  "title": "Box (% of page)",
                  "type": "object",
                  "required": ["x", "y", "w", "h"],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "w": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "h": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  }
                },
                "skus": {
                  "title": "SKUs",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "objectIds": {
                  "title": "Scheels Search product ids",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "inStoreOnly": {
                  "title": "In Store Only",
                  "type": "boolean"
                },
                "fallback": {
                  "title": "Link when no product",
                  "type": "object",
                  "properties": {
                    "category": {
                      "title": "Category",
                      "type": "string"
                    },
                    "attributes": {
                      "title": "Attribute Refinements",
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "attributeName": {
                            "title": "Attribute Name",
                            "type": "string"
                          },
                          "attributeValue": {
                            "title": "Attribute Value",
                            "type": "string"
                          }
                        }
                      }
                    },
                    "onSale": {
                      "title": "On Sale",
                      "type": "boolean"
                    },
                    "urlSlug": {
                      "title": "URL Slug",
                      "type": "string"
                    },
                    "pageID": {
                      "title": "Page ID",
                      "type": "string"
                    },
                    "productID": {
                      "title": "Product ID",
                      "type": "string"
                    },
                    "anchor": {
                      "title": "Anchor",
                      "type": "string"
                    },
                    "newPage": {
                      "title": "Open in New Page",
                      "type": "boolean"
                    },
                    "clickID": {
                      "title": "Click ID",
                      "type": "string"
                    },
                    "searchTerm": {
                      "title": "Search term",
                      "type": "string"
                    }
                  }
                },
                "buttonText": {
                  "title": "Button text",
                  "description": "Replaces the panel button's text, which otherwise describes the link.",
                  "type": "string",
                  "maxLength": 60
                },
                "linksTitle": {
                  "title": "Links title",
                  "description": "Optional heading above the links at the bottom of the product panel.",
                  "type": "string",
                  "maxLength": 50
                },
                "links": {
                  "title": "Links",
                  "description": "Extra links at the bottom of the product panel, as on a shoppable image.",
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "required": ["label", "link"],
                    "properties": {
                      "label": {
                        "title": "Label",
                        "description": "Text of the link",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "ariaLabel": {
                        "title": "Aria label",
                        "description": "Optional. Read by screen readers after the label.",
                        "type": "string",
                        "maxLength": 255
                      },
                      "clickId": {
                        "title": "Click ID",
                        "description": "Optional. Id for Google Analytics; digital-flyer-link when empty.",
                        "type": "string"
                      },
                      "link": {
                        "title": "Link",
                        "description": "Same fields as Link when no product. Keep the two in step.",
                        "type": "object",
                        "properties": {
                          "category": {
                            "title": "Category",
                            "type": "string"
                          },
                          "attributes": {
                            "title": "Attribute Refinements",
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "attributeName": {
                                  "title": "Attribute Name",
                                  "type": "string"
                                },
                                "attributeValue": {
                                  "title": "Attribute Value",
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "onSale": {
                            "title": "On Sale",
                            "type": "boolean"
                          },
                          "urlSlug": {
                            "title": "URL Slug",
                            "type": "string"
                          },
                          "pageID": {
                            "title": "Page ID",
                            "type": "string"
                          },
                          "productID": {
                            "title": "Product ID",
                            "type": "string"
                          },
                          "anchor": {
                            "title": "Anchor",
                            "type": "string"
                          },
                          "newPage": {
                            "title": "Open in New Page",
                            "type": "boolean"
                          },
                          "clickID": {
                            "title": "Click ID",
                            "type": "string"
                          },
                          "searchTerm": {
                            "title": "Search term",
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                },
                "locked": {
                  "title": "Edited by hand",
                  "type": "boolean"
                },
                "confidence": {
                  "type": "string",
                  "enum": ["high", "low"]
                }
              }
            }
          }
        }
      }
    },
    "parts": {
      "title": "More pages",
      "description": "For a flyer too big for one item (Amplience saves at most 200 KB). Each linked Digital Flyer adds its pages after these, in order; only its pages are used, not its settings or lock. The importer suggests where to split.",
      "type": "array",
      "maxItems": 4,
      "items": {
        "allOf": [
          { "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content-link" },
          { "properties": { "contentType": { "enum": ["https://scheels.com/contentTypes/digital-flyer"] } } }
        ]
      }
    }
  },
  "required": ["pages"],
  "propertyOrder": ["title", "campaign", "startDate", "endDate", "showWishlist", "lock", "disclaimer", "pages", "parts"]
}
